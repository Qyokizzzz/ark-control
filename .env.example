NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
# Separate frontend only. Set APP_ORIGIN to the HTTPS API address and WEB_ORIGIN to the HTTPS page origin.
# WEB_ORIGIN=https://your-account.github.io
AGENT_WINDOWS_PACKAGE_PATH=../../artifacts/ArkHostAgent-Windows-x64.zip
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=ark_control
DATABASE_USER=ark_control_app
DATABASE_PASSWORD=replace_with_database_password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_random_characters
ENCRYPTION_KEY=replace_with_64_hex_characters
INITIAL_ADMIN_EMAIL=admin@ark.local
INITIAL_ADMIN_PASSWORD=replace_with_at_least_12_characters
# Relative to apps/api, the working directory used by pnpm start/dev.
DATA_DIR=../../.data
WEB_DIST=../web/dist
QQ_API_BASE=https://api.bot.qq.com
QQ_GATEWAY_ENABLED=true
PLATFORM_QQ_APP_ID=
PLATFORM_QQ_APP_SECRET=
PLATFORM_QQ_CERTIFIED=false
MAX_BACKUP_GB=100
DEMO_MODE=false
# Optional overrides when API runs from a custom working directory:
# CONNECT_LAUNCHER_PATH=C:/ark-control/native/ArkConnect/dist/ArkConnect.exe
# CONNECT_VENDOR_DIR=C:/ark-control/native/ArkConnect/vendor
